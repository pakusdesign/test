# Режим работы сервера: demo — без внешних вызовов; live — Deepgram STT + Anthropic LLM.
# В live при отсутствии ключей сервер возвращает CONFIGURATION_ERROR и не переключается в demo.
APP_MODE=demo
PORT=3001
# Для локальной сдачи сервер слушает только loopback.
HOST=127.0.0.1

# Секреты хранятся только на сервере. Не используйте префикс VITE_ и не коммитьте .env.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# Распознавание локально. Укажите абсолютные пути. Модель должна быть многоязычной (без .en).
STT_PROVIDER=whisper
WHISPER_BINARY=
WHISPER_MODEL_PATH=
FFMPEG_BINARY=

# Резервный облачный вариант: STT_PROVIDER=deepgram.
STT_MODEL=nova-3
STT_LANGUAGE=ru

# Идентификатор модели Anthropic. Значение не задано намеренно:
# укажите модель, доступную вашему ключу (см. https://docs.claude.com/en/docs/about-claude/models).
LLM_PROVIDER=ollama
# Установите Ollama и выполните: ollama pull qwen3:4b-instruct
LLM_MODEL=qwen3:4b-instruct
# Для Anthropic задайте LLM_PROVIDER=anthropic, LLM_MODEL и ANTHROPIC_API_KEY.

LLM_MAX_TOKENS=4096

# Ограничения прототипа.
RATE_LIMIT_PER_MINUTE=20
PROVIDER_TIMEOUT_MS=45000
